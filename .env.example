# TODO: Create a Formspree form at https://formspree.io and paste the form ID below.
# Copy this file to `.env` in the project root (do not commit `.env`).
#
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Demo form (Formspree)
VITE_FORMSPREE_ID=

# Production canonical URL — no trailing slash (used for canonical tags, sitemap, robots)
# TODO: e.g. https://www.yourdomain.com
VITE_SITE_URL=https://example.com

# GA4 measurement ID — loaded only in production after cookie consent
# TODO: e.g. G-XXXXXXXXXX
VITE_GA_ID=
